{
    "version": "2.0",
    "telemetryMode": "OpenTelemetry",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        },
        "logLevel": {
            "default": "Information",
            "Host": "Information",
            "Function": "Information"
        },
        "includeScopes": true
    },
    "extensions": {
        "serviceBus": {
            "autoCompleteMessages": false,
            "maxAutoLockRenewalDuration": "01:00:00"
        },
        "durableTask": {
            "extendedSessionsEnabled": true, 
            "extendedSessionIdleTimeoutInSeconds": 10,
            "maxConcurrentOrchestratorFunctions": 10000000, 
            "hubName": "FundingRuleBridgeHub",
            "storageProvider": {
                "controlQueueBufferThreshold": 1000,  
                "partitionCount": 16 
            }
        }
    }
}
